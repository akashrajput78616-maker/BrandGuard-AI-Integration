# BrandGuard AI Review API Configuration
# Copy this file to .env and configure your keys.

# ==============================================================================
# 1. Google Gemini AI & Multi-Key Failover Agent
# ==============================================================================
# Primary Gemini API Key
GEMINI_API_KEY=replace_with_primary_gemini_api_key

# Additional backup keys for automatic failover when quota/tokens are exhausted:
# Option A: Numbered backup keys
GEMINI_API_KEY_2=replace_with_backup_key_2
GEMINI_API_KEY_3=replace_with_backup_key_3

# Option B: Or provide a comma-separated key pool
# GEMINI_API_KEYS=key1,key2,key3

GEMINI_MODEL=gemini-2.5-flash
FRONTEND_ORIGINS=http://localhost:5173,https://frontend-psi-self-29.vercel.app

# ==============================================================================
# 2. Enterprise Authentication & Security (Feature 2)
# ==============================================================================
JWT_SECRET=super-secret-brandguard-enterprise-signing-key-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=14

# ==============================================================================
# 3. Vector Store & Knowledge Base Ingestion (Feature 1)
# ==============================================================================
# Options: 'local' (In-memory + JSON persistence, default), 'postgres' (pgvector), 'pinecone'
VECTOR_STORE_PROVIDER=local

# When using VECTOR_STORE_PROVIDER=postgres:
DATABASE_URL=postgresql://user:password@localhost:5432/brandguard_db

# When using VECTOR_STORE_PROVIDER=pinecone:
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_INDEX_NAME=brandguard-guidelines
# PINECONE_ENVIRONMENT=us-east-1-aws

# ==============================================================================
# 4. Multi-Modal Vision & Brand Identity Standards (Feature 3)
# ==============================================================================
DELTA_E_TOLERANCE=5.0
WCAG_MINIMUM_LEVEL=AA

# BrandGuard AI Review API Configuration
# Copy this file to .env and configure your keys.

# ==============================================================================
# 1. Google Gemini AI & Multi-Key Failover Agent
# ==============================================================================
# Primary Gemini API Key
GEMINI_API_KEY=replace_with_primary_gemini_api_key

# Additional backup keys for automatic failover when quota/tokens are exhausted:
# Option A: Numbered backup keys
GEMINI_API_KEY_2=replace_with_backup_key_2
GEMINI_API_KEY_3=replace_with_backup_key_3

# Option B: Or provide a comma-separated key pool
# GEMINI_API_KEYS=key1,key2,key3

GEMINI_MODEL=gemini-2.5-flash

# Network & Server Binding
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=https://frontend-psi-self-29.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://frontend-psi-self-29.vercel.app

# ==============================================================================
# 2. Enterprise Authentication & Security (Feature 2)
# ==============================================================================
JWT_SECRET=super-secret-brandguard-enterprise-signing-key-32chars
JWT_REFRESH_SECRET=super-secret-brandguard-enterprise-refresh-key-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=14
# Set to 'true' in production for cross-site cookies between Vercel and Render (SameSite=None, Secure)
SECURE_COOKIES=true

# Optional: Enterprise SSO OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# ==============================================================================
# 3. Vector Store & Knowledge Base Ingestion (Feature 1)
# ==============================================================================
# Options: 'postgres' (pgvector on Neon / Supabase), 'local' (In-memory + JSON persistence fallback)
VECTOR_STORE_PROVIDER=postgres

# Neon / Supabase PostgreSQL Connection String (with sslmode=require)
DATABASE_URL=postgresql://brandguard_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# 4. Enterprise Integrations & Webhooks
# ==============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/XXXX

# ==============================================================================
# 5. Multi-Modal Vision & Brand Identity Standards (Feature 3)
# ==============================================================================
DELTA_E_TOLERANCE=5.0
WCAG_MINIMUM_LEVEL=AA


# BrandGuard Frontend Environment Configuration
# Add these variables to your Vercel Project Settings > Environment Variables

# Backend REST API URL (Render Web Service HTTPS URL)
# Example: https://brandguard-api-np6g.onrender.com
VITE_API_URL=https://brandguard-api-np6g.onrender.com

# Backend WebSocket URL (Render Web Service WSS URL)
# Example: wss://brandguard-api-np6g.onrender.com
VITE_WS_URL=wss://brandguard-api-np6g.onrender.com
